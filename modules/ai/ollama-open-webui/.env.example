# Copy to .env locally, set mode 0600, and replace blank values before Compose.
# Select and review exact upstream image digests for your architecture.
OLLAMA_IMAGE=
OPEN_WEBUI_IMAGE=
# Generate locally with: openssl rand -hex 32
WEBUI_SECRET_KEY=
# WebUI is bound to host loopback; choose a free local port.
WEBUI_PORT=3001

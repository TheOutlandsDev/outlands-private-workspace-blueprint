# Copy to a private .env. Select reviewed image digests for your architecture.
PYTHON_IMAGE=
PROMETHEUS_IMAGE=
GRAFANA_IMAGE=
# Relative to this Compose project; create locally with mode 0600.
GRAFANA_PASSWORD_FILE=.secrets/grafana-admin-password
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002
# fresh, stale, or unavailable; all values are fictional.
DEMO_MODE=fresh
